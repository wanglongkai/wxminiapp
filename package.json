{
  "name": "weapp-vite-wevu-template",
  "type": "module",
  "version": "1.0.5",
  "private": true,
  "description": "weapp-vite + wevu (Vue SFC) 模板",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-vite/weapp-vite.git",
    "directory": "templates/weapp-vite-wevu-template"
  },
  "bugs": {
    "url": "https://github.com/weapp-vite/weapp-vite/issues"
  },
  "keywords": [],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "wv dev",
    "dev:web": "wv dev -p web --host",
    "dev:open": "wv dev -o",
    "dev:ui": "wv dev --ui",
    "dev:open:ui": "wv dev --ui -o",
    "build": "wv build",
    "build:web": "wv build -p web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit -p .weapp-vite/tsconfig.app.json",
    "open": "wv open",
    "dev:server": "node --watch server/src/index.js",
    "start:server": "node server/src/index.js",
    "stylelint": "stylelint \"src/**/*.{css,scss,vue,wxss,acss,ttss,jxss,qss,tyss}\" --allow-empty-input",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss,vue,wxss,acss,ttss,jxss,qss,tyss}\" --fix --allow-empty-input",
    "postinstall": "wv prepare"
  },
  "devDependencies": {
    "@icebreakers/eslint-config": "8.0.20",
    "@icebreakers/stylelint-config": "6.0.5",
    "@types/node": "^26.6.6",
    "@weapp-vite/dashboard": "^7.12.1",
    "eslint": "^10.15.0",
    "miniprogram-api-typings": "^5.3.1",
    "stylelint": "^18.0.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14",
    "weapp-vite": "^7.12.1",
    "wevu": "^7.12.1"
  }
}